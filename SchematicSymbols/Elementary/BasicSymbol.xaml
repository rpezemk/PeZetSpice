<UserControl x:Class="SchematicSymbols.Elementary.BasicSymbol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SchematicSymbols.Elementary"
             mc:Ignorable="d" 
             x:Name="Root"
             d:DesignHeight="450" d:DesignWidth="800"
             RenderTransformOrigin="0.5,0.5"
             Cursor="Hand"
             ClipToBounds="False"
             MouseDoubleClick="Root_MouseDoubleClick">
    <UserControl.RenderTransform>
        <TransformGroup>
            <RotateTransform Angle="{Binding Path=RotationAngle}"/>
        </TransformGroup>
    </UserControl.RenderTransform>
    <Border BorderBrush="Red" BorderThickness="10" Margin="-10">
        <ContentPresenter Content="{Binding InnerContent, ElementName=Root}"/>
    </Border>
</UserControl>
